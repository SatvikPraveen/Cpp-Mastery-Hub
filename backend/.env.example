# Backend configuration. Validated at startup by backend/src/config/index.ts (zod schema);
# the server refuses to start if a required variable is missing or malformed.

NODE_ENV=development
PORT=8000
HOST=localhost

# Required
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/cpp_mastery_hub
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-64-hex-characters-from-openssl-rand
JWT_REFRESH_SECRET=replace-with-64-hex-characters-from-openssl-rand
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand

# Postgres (defaults shown)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cpp_mastery_hub
POSTGRES_USER=postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# MongoDB (community content)
MONGODB_URL=mongodb://localhost:27017/cpp_mastery_community

# Tokens
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=12

# Analysis engine
CPP_ENGINE_URL=http://localhost:9000
CPP_ENGINE_TIMEOUT=30000
# CPP_ENGINE_API_KEY=

# CORS / rate limiting
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=cpp,hpp,h,c,cc,cxx

# Logging / analytics
LOG_LEVEL=info
LOG_FILE=logs/app.log
ANALYTICS_ENABLED=false
# MIXPANEL_TOKEN=

# Optional integrations
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# WebSockets
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=60000
