# Copy to .env for docker compose. Never commit a real .env.
# Secrets below are placeholders; generate real ones with: openssl rand -hex 32

# --- Ports exposed on the host -------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
CPP_ENGINE_PORT=9000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PGADMIN_PORT=5050
MONGO_EXPRESS_PORT=8081

# --- Databases -----------------------------------------------------------------------------
POSTGRES_DB=cpp_mastery_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
MONGO_DB=cpp_mastery_community
MONGO_USER=admin
MONGO_PASSWORD=change-me
MONGO_PORT=27017

# --- Secrets (>= 32 characters) ------------------------------------------------------------
JWT_SECRET=replace-with-64-hex-characters-from-openssl-rand
JWT_REFRESH_SECRET=replace-with-64-hex-characters-from-openssl-rand
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand

# --- Public URLs ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_CPP_ENGINE_URL=http://localhost:9000
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Admin tools (development only) --------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me
CPP_ENGINE_LOG_LEVEL=INFO
