# Copy to .env for `docker compose up`. Never commit a real .env.
# Generate each secret with: openssl rand -hex 32   (the backend rejects secrets under 32 chars)

POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-hex-characters
SESSION_SECRET=replace-with-a-third-64-hex-characters

# Optional (defaults shown)
# POSTGRES_DB=cpp_mastery_hub
# POSTGRES_USER=postgres
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# NGINX_PORT=8080
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# CORS_ORIGIN=http://localhost:3000,http://localhost:8080
# FRONTEND_URL=http://localhost:3000
# SMTP_HOST=            # unset: emails are logged by the backend instead of sent
# LOG_LEVEL=info
